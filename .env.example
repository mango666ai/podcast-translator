# 复制为 .env 并填入真实值（.env 已 gitignore，不会进这个 public 仓库）
# 真实值记在私有笔记仓库 aicoding-notes/project5_podcast/PROJECT_MAP.md

# 翻译主通道（必须）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 备用翻译通道（可选，优先级排在 DeepSeek 之后）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# 声音克隆 + TTS（必须）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# 飞书：任务队列看板 + 云盘上传（可选，run_jobs.py / upload_feishu.py 用）
FEISHU_DOMAIN=
FEISHU_PROFILE=
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=
FEISHU_FOLDER_TOKEN=
